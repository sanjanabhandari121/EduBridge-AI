# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL="file:./dev.db"
# To use Postgres instead:
# DATABASE_URL="postgresql://user:password@localhost:5432/edubridge"

# --- AI Provider ---
# "mock" needs no key and runs fully offline using template + RAG-grounded logic.
# Switch to "gemini" or "openai" once you have a key — no other code changes needed.
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# --- Vector DB (future) ---
# Not required for MVP retrieval (keyword-based). Placeholder for pgvector/Qdrant/Chroma.
VECTOR_DB_URL=""

# --- Auth ---
JWT_SECRET="edubridge-dev-secret-change-me"

# --- Server ---
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
